# Copy to .env. Everything defaults to an offline sandbox.
BRAIN_DATA_STAGE=synthetic          # synthetic | anonymised (live is refused in the sandbox)
BRAIN_MODEL=sandbox                 # sandbox | ollama:gemma4 | openai:<model>
BRAIN_TRIAGE_MODEL=sandbox          # pilot plan: Gemma for triage too
BRAIN_MODEL_BASE_URL=http://localhost:11434/v1
BRAIN_MODEL_API_KEY=ollama
BRAIN_DATABASE_URL=sqlite:///data/brain.db
# BRAIN_DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain
BRAIN_TRAVELSPIRIT=fake             # only the fake exists until the client shares API access
BRAIN_TRAVELSPIRIT_WRITE=drafts     # drafts | off. Agents never write final records.
BRAIN_SEED=42
